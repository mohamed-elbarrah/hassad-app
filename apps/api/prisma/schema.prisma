generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                   String                    @id @default(uuid())
  name                 String
  email                String                    @unique
  passwordHash         String?                   @map("password_hash")
  roleId               String                    @map("role_id")
  isActive             Boolean                   @default(true) @map("is_active")
  isPayrollEligible    Boolean                   @default(false) @map("is_payroll_eligible")
  phoneWhatsapp        String?                   @map("phone_whatsapp")
  avatarUrl            String?                   @map("avatar_url")
  createdAt            DateTime                  @default(now()) @map("created_at")
  updatedAt            DateTime                  @updatedAt @map("updated_at")
  provider             String                    @default("local") @map("provider")
  providerId           String?                   @unique @map("provider_id")
  resetToken           String?                   @unique @map("reset_token")
  resetTokenExpiresAt  DateTime?                 @map("reset_token_expires_at")
  triggeredAiLogs      AiAnalysisLog[]
  actionedAiSuggs      AiSuggestion[]
  kpiAuditLogs         CampaignKpiAuditLog[]     @relation("KpiAuditChanger")
  campaignStatusChanges CampaignStatusHistory[]    @relation("CampaignStatusChanger")
  managedCampaigns     Campaign[]                @relation("CampaignManager")
  clientHistory        ClientHistoryLog[]
  managedClients       Client[]                  @relation("AccountManager")
  clientProfile        Client?                   @relation("ClientUser")
  contractVersions     ContractVersion[]
  createdContracts     Contract[]                @relation("ContractCreator")
  soldContracts        Contract[]                @relation("ContractSalesPerson")
  contractStatusChanges ContractStatusHistory[]   @relation("ContractStatusChangedBy")
  periodStatusChanges   ProjectPeriodHistory[]   @relation("ProjectPeriodChangedBy")
  createdMeetings      ProjectMeeting[]          @relation("MeetingCreatedBy")
  chatParticipants     ConversationParticipant[]
  approvedDelivs       Deliverable[]
  employee             Employee?
  internalRatings      InternalRating[]          @relation("RatedBy")
  createdInvoices      Invoice[]
  contactLogs          LeadContactLog[]
  leadHistory          LeadPipelineHistory[]
  assignedLeads        Lead[]                    @relation("LeadAssignee")
  createdLeads         Lead[]                    @relation("LeadCreator")
  ledgerEntries        Ledger[]
  sentMessages         Message[]
  notifications        Notification[]
  assignedTickets      PaymentTicket[]           @relation("TicketAssignee")
  uploadedProjectFiles ProjectFile[]
  projectMembers       ProjectMember[]
  managedProjects      Project[]                 @relation("ProjectManager")
  createdProposals     Proposal[]
  requestHistory       RequestStatusHistory[]    @relation("RequestStatusChangedBy")
  assignedRequests     Request[]                 @relation("RequestAssignee")
  submittedRequests    Request[]                 @relation("RequestSubmitter")
  workload             StaffWorkload?
  taskComments         TaskComment[]
  notifiedDelays       TaskDelayAlert[]
  uploadedFiles        TaskFile[]
  taskHistory          TaskStatusHistory[]
  approvedTasks        Task[]                    @relation("TaskApprover")
  assignedTasks        Task[]                    @relation("TaskAssignee")
  createdTasks         Task[]                    @relation("TaskCreator")
  createdStrategies    MarketingStrategy[]       @relation("StrategyCreator")
  approvedStrategies   MarketingStrategy[]       @relation("StrategyApprover")
  departments          UserDepartment[]
  permissions          UserPermission[]
  role                 Role                      @relation(fields: [roleId], references: [id])

  @@index([roleId])
  @@index([createdAt])
  @@map("users")
}

model Role {
  id          String           @id @default(uuid())
  name        String           @unique
  permissions RolePermission[]
  users       User[]

  @@map("roles")
}

model Permission {
  id    String           @id @default(uuid())
  name  String           @unique
  roles RolePermission[]
  users UserPermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String     @map("role_id")
  permissionId String     @map("permission_id")
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model UserPermission {
  userId       String     @map("user_id")
  permissionId String     @map("permission_id")
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, permissionId])
  @@map("user_permissions")
}

model Department {
  id              String           @id @default(uuid())
  name            String           @unique
  description     String?
  createdAt       DateTime         @default(now()) @map("created_at")
  tasks           Task[]
  userDepartments UserDepartment[]

  @@map("departments")
}

model UserDepartment {
  id           String     @id @default(uuid())
  userId       String     @map("user_id")
  departmentId String     @map("department_id")
  department   Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, departmentId])
  @@index([userId])
  @@index([departmentId])
  @@map("user_departments")
}

model Lead {
  id                  String                @id @default(uuid())
  companyName         String                @map("company_name")
  contactName         String                @map("contact_name")
  phoneWhatsapp       String                @map("phone_whatsapp")
  email               String?
  businessName        String                @map("business_name")
  businessType        BusinessType          @map("business_type")
  source              ClientSource
  assignedTo          String?               @map("assigned_to")
  pipelineStage       PipelineStage         @map("pipeline_stage")
  contactAttemptCount Int                   @default(0) @map("contact_attempt_count")
  lastContactAt       DateTime?             @map("last_contact_at")
  notes               String?
  isActive            Boolean               @default(true) @map("is_active")
  createdAt           DateTime              @default(now()) @map("created_at")
  updatedAt           DateTime              @updatedAt @map("updated_at")
  createdBy           String?               @map("created_by")
  requestId           String?               @unique @map("request_id")
  client              Client?
  automationLogs      LeadAutomationLog[]
  contactLogs         LeadContactLog[]
  pipelineHistory     LeadPipelineHistory[]
  services            LeadService[]
  assignee            User?                 @relation("LeadAssignee", fields: [assignedTo], references: [id])
  creator             User?                 @relation("LeadCreator", fields: [createdBy], references: [id])
  request             Request?              @relation(fields: [requestId], references: [id])
  proposals           Proposal[]

  @@index([assignedTo])
  @@index([createdBy])
  @@index([pipelineStage])
  @@index([createdAt])
  @@map("leads")
}

model LeadPipelineHistory {
  id        String        @id @default(uuid())
  leadId    String        @map("lead_id")
  fromStage PipelineStage @map("from_stage")
  toStage   PipelineStage @map("to_stage")
  changedBy String        @map("changed_by")
  changedAt DateTime      @default(now()) @map("changed_at")
  changer   User          @relation(fields: [changedBy], references: [id])
  lead      Lead          @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId])
  @@index([changedAt])
  @@map("lead_pipeline_history")
}

model LeadContactLog {
  id          String           @id @default(uuid())
  leadId      String           @map("lead_id")
  userId      String           @map("user_id")
  type        ContactLogType
  result      ContactLogResult
  notes       String?
  contactedAt DateTime         @default(now()) @map("contacted_at")
  lead        Lead             @relation(fields: [leadId], references: [id], onDelete: Cascade)
  user        User             @relation(fields: [userId], references: [id])

  @@index([leadId])
  @@index([userId])
  @@map("lead_contact_log")
}

model LeadAutomationRule {
  id            String              @id @default(uuid())
  name          String
  triggerType   String              @map("trigger_type")
  conditionJson Json                @map("condition_json")
  actionJson    Json                @map("action_json")
  isActive      Boolean             @default(true) @map("is_active")
  createdAt     DateTime            @default(now()) @map("created_at")
  logs          LeadAutomationLog[]

  @@map("lead_automation_rules")
}

model LeadAutomationLog {
  id           String             @id @default(uuid())
  leadId       String             @map("lead_id")
  ruleId       String             @map("rule_id")
  executedAt   DateTime           @default(now()) @map("executed_at")
  status       AutomationStatus
  responseData Json?              @map("response_data")
  lead         Lead               @relation(fields: [leadId], references: [id], onDelete: Cascade)
  rule         LeadAutomationRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)

  @@index([leadId])
  @@index([ruleId])
  @@map("lead_automation_logs")
}

model Client {
  id                   String                   @id @default(uuid())
  leadId               String?                  @unique @map("lead_id")
  companyName          String                   @map("company_name")
  contactName          String                   @map("contact_name")
  phoneWhatsapp        String                   @map("phone_whatsapp")
  email                String?
  businessName         String                   @map("business_name")
  businessType         BusinessType             @map("business_type")
  accountManager       String?                  @map("account_manager")
  status               ClientStatus
  portalAccessToken    String?                  @unique @map("portal_access_token")
  portalTokenExpiresAt DateTime?                @map("portal_token_expires_at")
  createdAt            DateTime                 @default(now()) @map("created_at")
  updatedAt            DateTime                 @updatedAt @map("updated_at")
  userId               String?                  @unique @map("user_id")
  intakeCompleted      Boolean                  @default(false) @map("intake_completed")
  totalProjects        Int                      @default(0) @map("total_projects")
  activeProjects       Int                      @default(0) @map("active_projects")
  completedProjects    Int                      @default(0) @map("completed_projects")
  cancelledProjects    Int                      @default(0) @map("cancelled_projects")
  totalContractValue   Float                    @default(0) @map("total_contract_value")
  totalInvoiced        Float                    @default(0) @map("total_invoiced")
  totalPaid            Float                    @default(0) @map("total_paid")
  lastProjectAt        DateTime?                @map("last_project_at")
  avgSatisfactionScore Float?                   @map("avg_satisfaction_score")
  campaigns            Campaign[]
  historyLogs          ClientHistoryLog[]
  revisionReqs         ClientRevisionRequest[]
  snoozedItems         ClientSnoozedItem[]
  marketingStrategies  MarketingStrategy[]
  manager              User?                    @relation("AccountManager", fields: [accountManager], references: [id])
  lead                 Lead?                    @relation(fields: [leadId], references: [id])
  user                 User?                    @relation("ClientUser", fields: [userId], references: [id])
  contracts            Contract[]
  conversations        Conversation[]
  invoices             Invoice[]
  payTickets           PaymentTicket[]
  payments             Payment[]
  intakeForms          PortalIntakeForm[]
  projectRevisionReqs  ProjectRevisionRequest[]
  projects             Project[]
  proposals            Proposal[]
  requests             Request[]
  satRatings           SatisfactionRating[]
  profile              ClientProfile?

  @@index([userId])
  @@index([accountManager])
  @@index([status])
  @@index([createdAt])
  @@map("clients")
}

model ClientHistoryLog {
  id          String   @id @default(uuid())
  clientId    String   @map("client_id")
  userId      String   @map("user_id")
  eventType   String   @map("event_type")
  description String
  metadata    Json?
  occurredAt  DateTime @default(now()) @map("occurred_at")
  client      Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  user        User     @relation(fields: [userId], references: [id])

  @@index([clientId])
  @@index([occurredAt])
  @@map("client_history_log")
}

model ClientProfile {
  id                      String   @id @default(uuid())
  clientId                String   @unique @map("client_id")
  client                  Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)

  // Section 1: Business Basics
  industry                String?
  businessDescription     String?  @db.Text @map("business_description")
  targetAudience          String?  @db.Text @map("target_audience")
  budgetRangeMin          Float?   @map("budget_range_min")
  budgetRangeMax          Float?   @map("budget_range_max")

  // Section 2: Marketing Goals
  campaignGoals           Json?    @map("campaign_goals")
  campaignOffer           String?  @db.Text @map("campaign_offer")
  competitors             String?
  seasonalTiming          String?  @map("seasonal_timing")

  // Section 3: Customer Journey
  orderMethods            Json?    @map("order_methods")
  abandonedCartSystem     Boolean? @default(false) @map("abandoned_cart_system")

  // Section 4: Creative & Brand Assets
  hasVisualIdentity       Boolean? @default(false) @map("has_visual_identity")
  brandAssets             Json?    @map("brand_assets")
  visualReferences        String?  @map("visual_references")
  uploadedFiles           Json?    @map("uploaded_files")

  createdBy               String?  @map("created_by")
  createdAt               DateTime @default(now()) @map("created_at")
  updatedAt               DateTime @updatedAt @map("updated_at")

  @@index([clientId])
  @@map("client_profile")
}

model ServiceCatalog {
  id                   String                @id @default(uuid())
  name                 String
  nameAr               String                @map("name_ar")
  description          String?
  descriptionAr        String?               @map("description_ar")
  category             ServiceCategory
  estimatedDays        Int                   @default(30) @map("estimated_days")
  basePrice            Float                 @default(0) @map("base_price")
  isActive             Boolean               @default(true) @map("is_active")
  sortOrder            Int                   @default(0) @map("sort_order")
  createdAt            DateTime              @default(now()) @map("created_at")
  updatedAt            DateTime              @updatedAt @map("updated_at")
  deliverableTemplates DeliverableTemplate[]
  leadServices         LeadService[]
  requestServices      RequestService[]

  @@index([category])
  @@index([isActive])
  @@map("service_catalog")
}

model DeliverableTemplate {
  id            String         @id @default(uuid())
  serviceId     String         @map("service_id")
  title         String
  titleAr       String         @map("title_ar")
  description   String?
  descriptionAr String?        @map("description_ar")
  sortOrder     Int            @default(0) @map("sort_order")
  createdAt     DateTime       @default(now()) @map("created_at")
  service       ServiceCatalog @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@index([serviceId])
  @@map("deliverable_templates")
}

model Request {
  id              String                 @id @default(uuid())
  clientId        String                 @map("client_id")
  submittedBy     String?                @map("submitted_by")
  assignedSalesId String?                @map("assigned_sales_id")
  companyName     String                 @map("company_name")
  contactName     String                 @map("contact_name")
  phoneWhatsapp   String                 @map("phone_whatsapp")
  email           String?
  businessName    String                 @map("business_name")
  businessType    BusinessType           @map("business_type")
  source          ClientSource
  notes           String?
  status          RequestStatus          @default(SUBMITTED)
  createdAt       DateTime               @default(now()) @map("created_at")
  updatedAt       DateTime               @updatedAt @map("updated_at")
  contracts       Contract[]
  lead            Lead?
  project         Project?
  proposals       Proposal[]
  services        RequestService[]
  statusHistory   RequestStatusHistory[]
  assignee        User?                  @relation("RequestAssignee", fields: [assignedSalesId], references: [id])
  client          Client                 @relation(fields: [clientId], references: [id], onDelete: Cascade)
  submitter       User?                  @relation("RequestSubmitter", fields: [submittedBy], references: [id])

  @@index([clientId])
  @@index([submittedBy])
  @@index([assignedSalesId])
  @@index([status])
  @@index([createdAt])
  @@map("requests")
}

model RequestService {
  id        String         @id @default(uuid())
  requestId String         @map("request_id")
  serviceId String         @map("service_id")
  quantity  Int            @default(1)
  notes     String?
  createdAt DateTime       @default(now()) @map("created_at")
  request   Request        @relation(fields: [requestId], references: [id], onDelete: Cascade)
  service   ServiceCatalog @relation(fields: [serviceId], references: [id])

  @@unique([requestId, serviceId])
  @@index([requestId])
  @@index([serviceId])
  @@map("request_services")
}

model RequestStatusHistory {
  id         String         @id @default(uuid())
  requestId  String         @map("request_id")
  fromStatus RequestStatus? @map("from_status")
  toStatus   RequestStatus  @map("to_status")
  changedBy  String?        @map("changed_by")
  note       String?
  changedAt  DateTime       @default(now()) @map("changed_at")
  changer    User?          @relation("RequestStatusChangedBy", fields: [changedBy], references: [id])
  request    Request        @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@index([requestId])
  @@index([changedAt])
  @@map("request_status_history")
}

model LeadService {
  id        String         @id @default(uuid())
  leadId    String         @map("lead_id")
  serviceId String         @map("service_id")
  quantity  Int            @default(1)
  notes     String?
  createdAt DateTime       @default(now()) @map("created_at")
  lead      Lead           @relation(fields: [leadId], references: [id], onDelete: Cascade)
  service   ServiceCatalog @relation(fields: [serviceId], references: [id])

  @@unique([leadId, serviceId])
  @@index([leadId])
  @@index([serviceId])
  @@map("lead_services")
}

model Proposal {
  id                 String         @id @default(uuid())
  leadId             String?        @map("lead_id")
  createdBy          String         @map("created_by")
  title              String
  serviceDescription String         @map("service_description")
  servicesList       Json           @map("services_list")
  totalPrice         Float          @map("total_price")
  durationDays       Int            @map("duration_days")
  platforms          Json
  status             ProposalStatus
  shareLinkToken     String?        @unique @map("share_link_token")
  sentAt             DateTime?      @map("sent_at")
  approvedAt         DateTime?      @map("approved_at")
  createdAt          DateTime       @default(now()) @map("created_at")
  filePath           String?        @map("file_path")
  clientId           String?        @map("client_id")
  requestId          String?        @map("request_id")
  contactEmail       String?        @map("contact_email")
  contactName        String?        @map("contact_name")
  durationUnit       String         @default("DAYS") @map("duration_unit")
  offerValidityDays  Int            @default(30) @map("offer_validity_days")
  startDate          DateTime?      @map("start_date")
  contract           Contract?
  client             Client?        @relation(fields: [clientId], references: [id])
  creator            User           @relation(fields: [createdBy], references: [id])
  lead               Lead?          @relation(fields: [leadId], references: [id])
  request            Request?       @relation(fields: [requestId], references: [id])

  @@index([requestId])
  @@index([leadId])
  @@index([clientId])
  @@index([createdBy])
  @@index([status])
  @@map("proposals")
}

model Contract {
  id             String                 @id @default(uuid())
  clientId       String                 @map("client_id")
  proposalId     String?                @unique @map("proposal_id")
  createdBy      String                 @map("created_by")
  salesPersonId  String?                @map("sales_person_id")
  title          String
  type           ContractType
  status         ContractStatus
  startDate      DateTime               @map("start_date")
  endDate        DateTime               @map("end_date")
  monthlyValue   Float                  @map("monthly_value")
  totalValue     Float                  @map("total_value")
  filePath       String?                @map("file_path")
  versionNumber  Int                    @default(1) @map("version_number")
  eSigned        Boolean                @default(false) @map("e_signed")
  signedAt       DateTime?              @map("signed_at")
  createdAt      DateTime               @default(now()) @map("created_at")
  shareLinkToken String?                @unique @map("share_link_token")
  currency       String                 @default("SAR") @map("currency")
  requestId      String?                @map("request_id")
  servicesList   Json?                  @map("services_list")
  // ── Billing plan (Phase 1: down-payment activation gate) ────────────────────
  downPaymentType   PaymentAmountType?   @map("down_payment_type")
  downPaymentValue  Float?               @map("down_payment_value")
  numberOfMonths    Int?                @map("number_of_months")
  renewalAlerts  ContractRenewalAlert[]
  versions       ContractVersion[]
  paymentPlans   ContractPaymentPlan[]
  statusHistory  ContractStatusHistory[]
  client         Client                 @relation(fields: [clientId], references: [id], onDelete: Cascade)
  creator        User                   @relation("ContractCreator", fields: [createdBy], references: [id])
  salesPerson    User?                  @relation("ContractSalesPerson", fields: [salesPersonId], references: [id])
  proposal       Proposal?              @relation(fields: [proposalId], references: [id])
  request        Request?               @relation(fields: [requestId], references: [id])
  invoices       Invoice[]
  projects       Project[]

  @@index([requestId])
  @@index([clientId])
  @@index([salesPersonId])
  @@index([status])
  @@map("contracts")
}

model ContractVersion {
  id            String   @id @default(uuid())
  contractId    String   @map("contract_id")
  versionNumber Int      @map("version_number")
  filePath      String   @map("file_path")
  createdBy     String   @map("created_by")
  createdAt     DateTime @default(now()) @map("created_at")
  contract      Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  creator       User     @relation(fields: [createdBy], references: [id])

  @@index([contractId])
  @@map("contract_versions")
}

model ContractRenewalAlert {
  id          String           @id @default(uuid())
  contractId  String           @map("contract_id")
  alertType   RenewalAlertType @map("alert_type")
  isSent      Boolean          @default(false) @map("is_sent")
  scheduledAt DateTime         @map("scheduled_at")
  sentAt      DateTime?        @map("sent_at")
  contract    Contract         @relation(fields: [contractId], references: [id], onDelete: Cascade)

  @@index([contractId])
  @@map("contract_renewal_alerts")
}

/// Planned payment for a contract (down payment, recurring monthly, milestones).
/// Drives invoice generation. Belongs to the commercial Contract layer.
model ContractPaymentPlan {
  id            String                @id @default(uuid())
  contractId    String                @map("contract_id")
  label         String
  sequence      Int                   @default(0)
  triggerType   PaymentPlanTriggerType @map("trigger_type")
  amountType    PaymentAmountType     @map("amount_type")
  amountValue   Float                 @map("amount_value")
  isRecurring   Boolean              @default(false) @map("is_recurring")
  dueOffsetDays Int?                 @map("due_offset_days")
  isActive      Boolean              @default(true) @map("is_active")
  createdAt     DateTime            @default(now()) @map("created_at")
  updatedAt     DateTime            @updatedAt @map("updated_at")
  contract      Contract             @relation(fields: [contractId], references: [id], onDelete: Cascade)
  invoices      Invoice[]

  @@index([contractId])
  @@index([triggerType])
  @@map("contract_payment_plans")
}

/// Audit trail of contract status transitions (RULE 2: history on every state change).
model ContractStatusHistory {
  id          String   @id @default(uuid())
  contractId  String   @map("contract_id")
  fromStatus  ContractStatus @map("from_status")
  toStatus    ContractStatus @map("to_status")
  changedBy   String   @map("changed_by")
  reason      String?
  changedAt   DateTime @default(now()) @map("changed_at")
  contract    Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  changedByUser User    @relation("ContractStatusChangedBy", fields: [changedBy], references: [id])

  @@index([contractId])
  @@index([toStatus])
  @@map("contract_status_history")
}

model Project {
  id                   String                   @id @default(uuid())
  clientId             String                   @map("client_id")
  contractId           String?                  @map("contract_id")
  projectManagerId     String?                  @map("project_manager_id")
  name                 String
  description          String?
  status               ProjectStatus
  priority             TaskPriority             @map("priority")
  startDate            DateTime                 @map("start_date")
  endDate              DateTime                 @map("end_date")
  completionPercentage Float                    @default(0) @map("completion_percentage")
  isArchived           Boolean                  @default(false) @map("is_archived")
  archivedAt           DateTime?                @map("archived_at")
  createdAt            DateTime                 @default(now()) @map("created_at")
  updatedAt            DateTime                 @updatedAt @map("updated_at")
  requestId            String?                  @unique @map("request_id")
  campaigns            Campaign[]
  deliverables         Deliverable[]
  invoiceItems         InvoiceItem[]
  files                ProjectFile[]
  members              ProjectMember[]
  revisionRequests     ProjectRevisionRequest[]
  marketingStrategies  MarketingStrategy[]
  client               Client                   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  contract             Contract?                @relation(fields: [contractId], references: [id])
  manager              User?                    @relation("ProjectManager", fields: [projectManagerId], references: [id])
  request              Request?                 @relation(fields: [requestId], references: [id])
  satRatings           SatisfactionRating[]
  tasks                Task[]
  teamConversation     Conversation?
  periods              ProjectPeriod[]
  meetings             ProjectMeeting[]

  @@index([requestId])
  @@index([clientId])
  @@index([projectManagerId])
  @@index([status])
  @@map("projects")
}

model ProjectMember {
  id        String            @id @default(uuid())
  projectId String            @map("project_id")
  userId    String            @map("user_id")
  role      ProjectMemberRole
  joinedAt  DateTime          @default(now()) @map("joined_at")
  project   Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user      User              @relation(fields: [userId], references: [id])

  @@index([projectId])
  @@index([userId])
  @@map("project_members")
}

/// One billing/delivery period (≈ one month) of a retainer project. Belongs to a Project.
/// Phase 2: lifecycle (UPCOMING→ACTIVE→CLOSED) + PM summary/report + period-scoped work.
/// Phase 3: links to the recurring invoice issued at close + suspend on overdue.
model ProjectPeriod {
  id                   String              @id @default(uuid())
  projectId            String              @map("project_id")
  periodNumber         Int                 @map("period_number")
  startDate            DateTime            @map("start_date")
  endDate              DateTime            @map("end_date")
  status               ProjectPeriodStatus
  summary              String?
  reportFilePath       String?             @map("report_file_path")
  completionPercentage Float              @default(0) @map("completion_percentage")
  /// PM-defined goals for this period (visible to client)
  goals                Json?
  invoiceId            String?             @unique @map("invoice_id")
  closedAt             DateTime?           @map("closed_at")
  suspendedAt          DateTime?           @map("suspended_at")
  resumedAt            DateTime?           @map("resumed_at")
  createdAt            DateTime            @default(now()) @map("created_at")
  updatedAt            DateTime            @updatedAt @map("updated_at")
  project              Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  invoice              Invoice?            @relation("ProjectPeriodInvoice", fields: [invoiceId], references: [id])
  tasks                Task[]
  deliverables         Deliverable[]
  files                ProjectFile[]
  campaigns            Campaign[]
  kpiSnapshots         CampaignKpiSnapshot[]
  statusHistory        ProjectPeriodHistory[]
  meetings             ProjectMeeting[]

  @@index([projectId])
  @@index([status])
  @@index([periodNumber])
  @@map("project_periods")
}

/// Audit trail of period status transitions (RULE 2: history on every state change).
model ProjectPeriodHistory {
  id            String              @id @default(uuid())
  periodId      String              @map("period_id")
  fromStatus    ProjectPeriodStatus @map("from_status")
  toStatus      ProjectPeriodStatus @map("to_status")
  changedBy     String              @map("changed_by")
  reason        String?
  changedAt     DateTime            @default(now()) @map("changed_at")
  period        ProjectPeriod       @relation(fields: [periodId], references: [id], onDelete: Cascade)
  changedByUser User               @relation("ProjectPeriodChangedBy", fields: [changedBy], references: [id])

  @@index([periodId])
  @@index([toStatus])
  @@map("project_period_history")
}

/// Client meeting scheduled by the PM for a specific delivery period.
/// SCHEDULED → DONE | CANCELLED; SCHEDULED → RESCHEDULED → SCHEDULED.
model ProjectMeeting {
  id            String        @id @default(uuid())
  projectId     String        @map("project_id")
  periodId      String        @map("period_id")
  title         String
  scheduledAt   DateTime      @map("scheduled_at")
  durationMin   Int?          @map("duration_min")
  location      String?
  meetingLink   String?       @map("meeting_link")
  status        MeetingStatus @default(SCHEDULED)
  /// PM notes / outcome report written after the meeting (optional).
  notes         String?
  createdBy     String        @map("created_by")
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")
  project       Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  period        ProjectPeriod @relation(fields: [periodId], references: [id], onDelete: Cascade)
  creator       User          @relation("MeetingCreatedBy", fields: [createdBy], references: [id])

  @@index([projectId])
  @@index([periodId])
  @@index([status])
  @@index([scheduledAt])
  @@map("project_meetings")
}

model Task {
  id                String              @id @default(uuid())
  projectId         String              @map("project_id")
  departmentId      String              @map("department_id")
  assignedTo        String?             @map("assigned_to")
  createdBy         String              @map("created_by")
  approvedBy        String?             @map("approved_by")
  title             String
  description       String?
  status            TaskStatus
  priority          TaskPriority
  dueDate           DateTime            @map("due_date")
  startedAt         DateTime?           @map("started_at")
  submittedAt       DateTime?           @map("submitted_at")
  approvedAt        DateTime?           @map("approved_at")
  revisionCount     Int                 @default(0) @map("revision_count")
  isVisibleToClient Boolean             @default(false) @map("is_visible_to_client")
  periodId          String?             @map("period_id")
  createdAt         DateTime            @default(now()) @map("created_at")
  updatedAt         DateTime            @updatedAt @map("updated_at")
  archivedAt        DateTime?           @map("archived_at")
  campaigns         Campaign[]
  deliverables      Deliverable[]
  marketingStrategies MarketingStrategy[]
  internalRating    InternalRating?
  invoiceItems      InvoiceItem[]
  comments          TaskComment[]
  delayAlerts       TaskDelayAlert[]
