{
  "name": "api",
  "version": "0.0.1",
  "private": true,
  "prisma": {
    "seed": "ts-node prisma/seed.ts"
  },
  "scripts": {
    "prebuild": "npm --prefix ../../packages/shared run build",
    "build": "nest build",
    "prestart:dev": "npm --prefix ../../packages/shared run build",
    "format": "prettier --write \"src/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "dev": "npm run start:dev",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "backfill:create-projects": "ts-node scripts/backfill-create-projects-from-signed-contracts.ts",
    "verify:crm-migration": "ts-node scripts/verify-legacy-crm-migration.ts",
    "verify:request-canonical": "ts-node scripts/verify-request-canonical.ts",
    "resolve:legacy-contracts": "ts-node scripts/resolve-legacy-contracts.ts",
    "recompute:client-counters": "ts-node src/scripts/backfill-client-counters.ts",
    "patch:pm-task-create-permission": "ts-node scripts/patch-pm-task-create-permission.ts",
    "test:e2e": "vitest run --config src/test/vitest.config.ts",
    "test:e2e:watch": "vitest --config src/test/vitest.config.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1045.0",
    "@aws-sdk/s3-request-presigner": "^3.1045.0",
    "@hassad/shared": "*",
    "@nestjs/axios": "^4.0.1",
    "@nestjs/common": "^11.x",
    "@nestjs/config": "^4.x",
    "@nestjs/core": "^11.x",
    "@nestjs/event-emitter": "^3.0.1",
    "@nestjs/jwt": "^11.x",
    "@nestjs/passport": "^11.x",
    "@nestjs/platform-express": "^11.x",
    "@nestjs/platform-socket.io": "^11.1.19",
    "@nestjs/schedule": "^5.x",
    "@nestjs/terminus": "^11.1.1",
    "@nestjs/throttler": "^6.5.0",
    "@nestjs/websockets": "^11.1.19",
    "@prisma/client": "^6.x",
    "@types/nodemailer": "^8.0.0",
    "@types/passport-google-oauth20": "^2.0.17",
    "bcrypt": "^6.0.0",
    "class-transformer": "^0.5.x",
    "class-validator": "^0.14.x",
    "cookie-parser": "^1.4.7",
    "nodemailer": "^8.0.7",
    "passport": "^0.7.x",
    "passport-google-oauth20": "^2.0.0",
    "passport-jwt": "^4.x",
    "reflect-metadata": "^0.2.x",
    "rxjs": "^7.x",
    "socket.io": "^4.8.3",
    "stripe": "^17.x"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.x",
    "@nestjs/schematics": "^11.x",
    "@nestjs/testing": "^11.1.28",
    "@types/bcrypt": "^6.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.x",
    "@types/multer": "^2.1.0",
    "@types/node": "^22.x",
    "@types/passport-jwt": "^4.x",
    "@types/supertest": "^7.2.1",
    "prisma": "^6.x",
    "supertest": "^7.2.2",
    "ts-loader": "^9.x",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.x",
    "tsx": "^4.21.0",
    "typescript": "^5.x",
    "vitest": "^4.1.10"
  }
}
