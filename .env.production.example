# ── Domain / IP (SET ONE OF THESE) ─────────────────
DOMAIN=yourdomain.com    # Required for production HTTPS.
SERVER_IP=123.45.67.89   # Your VPS public IP. Always required.

# ── PostgreSQL ─────────────────────────────────────
POSTGRES_USER=hassad
POSTGRES_PASSWORD=CHANGE_ME_TO_STRONG_RANDOM_PASSWORD
POSTGRES_DB=hassad
# Exact existing Docker volume name. Discover it with:
# docker inspect hassad-postgres --format '{{range .Mounts}}{{println .Name}}{{end}}'
POSTGRES_VOLUME_NAME=massar_postgres_data
# DATABASE_URL must be a complete URL. Keep the password URL-encoded.
DATABASE_URL=postgresql://hassad:CHANGE_ME_TO_STRONG_RANDOM_PASSWORD@postgres:5432/hassad

# ── JWT Secrets ────────────────────────────────────
JWT_SECRET=CHANGE_ME_TO_LONG_RANDOM_STRING
JWT_REFRESH_SECRET=CHANGE_ME_TO_ANOTHER_LONG_RANDOM_STRING
# Required: stable high-entropy secret used to encrypt database-backed AI provider API keys.
KEY_ENCRYPTION_SECRET=CHANGE_ME_TO_A_STABLE_RANDOM_SECRET
JWT_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=7d
COOKIE_TOKEN_MAX_AGE=3600000
COOKIE_REFRESH_TOKEN_MAX_AGE=604800000

# ── API ────────────────────────────────────────────
PORT=3001
NODE_ENV=production
# WEB_URL, FRONTEND_URL auto-constructed from DOMAIN (or SERVER_IP if DOMAIN is empty)

# ── Web (Next.js) ──────────────────────────────────
# NEXT_PUBLIC_API_URL and APP_URL are provided by docker-compose.prod.yml from DOMAIN

# ── Email (SMTP) ───────────────────────────────────
SMTP_HOST=smtp.ethereal.email
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# SMTP_FROM is provided by docker-compose.prod.yml from DOMAIN

# ── File Storage (Cloudflare R2) ───────────────────
CLOUDFLARE_R2_BUCKET=
CLOUDFLARE_R2_ENDPOINT=
CLOUDFLARE_R2_ACCESS_KEY=
CLOUDFLARE_R2_SECRET_KEY=
CLOUDFLARE_R2_PUBLIC_DOMAIN=

# ── Payments (Moyasar) ─────────────────────────────
MOYASAR_API_KEY=

# ── Google OAuth ───────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# GOOGLE_CALLBACK_URL is provided by docker-compose.prod.yml from DOMAIN
# OAuth providers require a real domain.

# ── Snapchat OAuth ─────────────────────────────────
SNAPCHAT_CLIENT_ID=
SNAPCHAT_CLIENT_SECRET=
# SNAPCHAT_CALLBACK_URL is provided by docker-compose.prod.yml from DOMAIN

# ── AI providers ───────────────────────────────────
# Providers and API keys are managed in the admin AI settings; do not put keys here.
# If baseUrl is omitted or blank, the API persists these defaults:
# OpenAI:     https://api.openai.com/v1
# OpenRouter: https://openrouter.ai/api/v1
# Anthropic:  https://api.anthropic.com/v1
# Google:     https://generativelanguage.googleapis.com
