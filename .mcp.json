{
  "mcpServers": {
    "next-devtools": {
      "command": "bash",
      "args": [
        "-lc",
        "source \"$HOME/.nvm/nvm.sh\" && exec npx -y next-devtools-mcp@latest"
      ]
    },
    "shadcn": {
      "command": "bash",
      "args": [
        "-lc",
        "source \"$HOME/.nvm/nvm.sh\" && exec npx -y shadcn@latest mcp"
      ],
      "cwd": "./apps/web"
    }
  }
}
